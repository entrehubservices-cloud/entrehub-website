// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Blog Post Model
model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String   @db.Text
  coverImage  String
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  publishedAt DateTime?
  editorialUpdatedAt DateTime?
  coverImageAlt String?
  readTime    String
  views       Int      @default(0)
  
  // Relations
  authorId    String
  author      Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tags        Tag[]    @relation("BlogPostTags")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([slug])
  @@index([published, publishedAt])
  @@index([categoryId])
  @@index([featured])
  @@index([authorId])
}

// Author Model
model Author {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  avatar    String?
  bio       String?
  posts     BlogPost[]
  
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// Category Model
model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  posts       BlogPost[]
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// Tag Model
model Tag {
  id    String     @id @default(cuid())
  name  String     @unique
  slug  String     @unique
  posts BlogPost[] @relation("BlogPostTags")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Contact Message Model
model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String        @db.Text
  status    MessageStatus @default(UNREAD)
  notes     String?       @db.Text
  
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  
  @@index([status])
  @@index([createdAt])
}

enum MessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}

// Admin User Model (for authentication)
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(EDITOR)
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  @@index([email])
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

// About Section Model
model AboutSection {
  id          String   @id @default(cuid())
  type        String   @unique // 'mission', 'vision', 'values'
  title       String
  content     String   @db.Text
  icon        String?  // Name of the Lucide icon
  
  updatedAt   DateTime @updatedAt
}

// Service Model
model Service {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  icon        String   // Name of the Lucide icon
  included    String   @default("What's included in service?")
  order       Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Portfolio Project Model
model PortfolioProject {
  published Boolean @default(false)
  status String @default("DRAFT")
  projectUrl String?
  id          String   @id @default(cuid())
  title       String
  category    String
  description String   @db.Text
  image       String
  metric      String?
  metricLabel String?
  order       Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Team Member Model
model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  image     String
  order     Int      @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Webinar Registration Model
model WebinarRegistration {
  id                  String    @id @default(cuid())
  firstName           String
  lastName            String
  email               String
  phone               String?
  jobTitle            String?
  companyName         String?
  country             String
  state               String?
  city                String?
  industry            String
  timezone            String
  howDidYouHear       String?
  topicsOfInterest    String[]  // Array of strings
  agreeToTerms        Boolean
  subscribeUpdates    Boolean   @default(false)
  emailDeliveryStatus String    @default("NOT_CONFIGURED")
  emailDeliveryError  String?
  emailSentAt         DateTime?
  reminderSentAt      DateTime?

  // Relation to Webinar
  webinarId           String?
  webinar             Webinar?  @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([webinarId, email])
  @@index([email])
  @@index([createdAt])
  @@index([webinarId])
}

// Webinar & Event Model
model Webinar {
  id                      String    @id @default(cuid())
  slug                    String?   @unique
  title                   String
  shortSummary            String?   @db.Text
  description             String?   @db.Text
  category                String    @default("Webinar")
  coverImage              String?
  scheduledAt             DateTime
  endsAt                  DateTime?
  timezone                String    @default("Africa/Lagos")
  format                  String    @default("ONLINE")
  meetingLink             String?
  location                String?
  speakerName             String?
  speakerTitle            String?
  speakerBio              String?   @db.Text
  capacity                Int?
  registrationClosesAt    DateTime?
  status                  String    @default("DRAFT")
  isActive                Boolean   @default(true)
  isFree                  Boolean   @default(true)
  remindersEnabled        Boolean   @default(false)
  googleCalendarEventId   String?
  googleCalendarHtmlLink  String?
  googleMeetRequestId     String?
  googleCalendarSyncedAt  DateTime?
  googleCalendarLastError String?

  registrations           WebinarRegistration[]

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([isActive])
  @@index([status])
  @@index([scheduledAt])
}
